# ------------------------------------------------------------------------------
# TRACECHO — Core Environment Configuration
# ------------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://tracecho:password@127.0.0.1:5432/tracecho

# Authentication & Security
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_DAYS=7

# LLM & Embeddings
GOOGLE_API_KEY=your-gemini-key-here

# ------------------------------------------------------------------------------
# SMTP Email Configuration (Optional)
# If SMTP_ENABLED=false (or not set), contact form submissions are safely persisted
# in PostgreSQL and marked as received without attempting email dispatch.
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="TRACECHO Regulatory Intelligence"
ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# Gmail SMTP App Password Setup Instructions:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Go to "App passwords" (or search "App passwords" in Google Account settings):
#    https://myaccount.google.com/apppasswords
# 3. Create a new app password named "TRACECHO Platform".
# 4. Copy the generated 16-character code (e.g., "abcd efgh ijkl mnop").
# 5. Set:
#    SMTP_ENABLED=true
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASSWORD=abcdefghijklmnop (without spaces)
#    ADMIN_EMAIL=your-notification-inbox@yourdomain.com
# ------------------------------------------------------------------------------
